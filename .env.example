# Copy to `.env` in this directory (never commit `.env`).
# Docker Compose reads this file for variable substitution on `db` and `server`.
#
# Generate a strong password (hex is URL-safe for DATABASE_URL):
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=

# Host port for Postgres (container always listens on 5432 internally).
# Change this if 5432 is already in use on the host (e.g. another Postgres instance).
POSTGRES_HOST_PORT=5432

# Required. Guards /api/admin/*, which can start a 20-minute scrape. The site is
# published to the internet through the reverse proxy, so these routes must not be
# open; Compose refuses to start without this.
#   openssl rand -hex 32
ADMIN_TOKEN=

# Browser origins allowed by CORS, comma separated. Include the public origin.
WEB_ORIGIN=http://localhost:5173,https://filmtracker.problex.com

# Public origin of the site. Sign-in and unsubscribe links are built from this, and
# the session cookie is only marked Secure when it is https.
PUBLIC_BASE_URL=https://filmtracker.problex.com

# Email delivery for sign-in links and price alerts.
#
# Preferred: Microsoft Graph, sending as a mailbox in the M365 tenant that already
# handles this domain. Nothing to add to DNS — Exchange Online is already authorised by
# the domain's SPF and signs with its own DKIM. Direct SMTP is not an option: this NAS
# is on a residential IP, where it is filtered as spam.
#
# Set up in Entra ID: register an app, grant the Microsoft Graph APPLICATION permission
# Mail.Send with admin consent, then create a client secret.
#
# IMPORTANT: Mail.Send as an application permission lets the app send as ANY mailbox in
# the tenant. Restrict it to the one mailbox, in Exchange Online PowerShell:
#
#   New-ApplicationAccessPolicy -AppId <client-id> \
#     -PolicyScopeGroupId info@problex.com \
#     -AccessRight RestrictAccess -Description "FilmTracker price alerts"
#
# Client secrets expire (12-24 months) and alerts go quiet when they do.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=info@problex.com

# Fallback, used only when the Graph variables above are unset. With neither
# configured the server logs emails rather than sending them, which also means sign-in
# only works for someone who can read the container logs.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@problex.com

# Fall that counts as a price drop for followers who have not set a target price.
ALERT_DROP_PERCENT=10
