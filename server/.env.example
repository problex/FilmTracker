# Must match Postgres (root `.env` POSTGRES_PASSWORD when using Docker, or your DB password).
# Example: postgres://filmtracker:YOUR_PASSWORD@localhost:5432/filmtracker
DATABASE_URL=postgres://filmtracker:filmtracker@localhost:5432/filmtracker
PORT=4000
# 0.0.0.0 accepts connections from your LAN (default). Use 127.0.0.1 to block remote devices.
LISTEN_HOST=0.0.0.0
# Comma-separated browser origins. Private LAN origins (192.168.x, 10.x, 172.16–31.x) are also allowed unless ALLOW_LAN_ORIGINS=false.
WEB_ORIGIN=http://localhost:5173
ALLOW_LAN_ORIGINS=true
# Comma-separated hours (0–23), server local time. Default 0,12 = twice daily at midnight and noon.
SCRAPE_HOURS=0,12

# Required. Guards /api/admin/*, which can start a 20-minute scrape — the API is
# reachable from the internet through the reverse proxy, so these routes cannot be
# open. The server refuses to start without this rather than serving them unguarded.
#   openssl rand -hex 32
# Send it as `X-Admin-Token: <value>` or `Authorization: Bearer <value>`.
ADMIN_TOKEN=


# Per-store scrape time budgets in milliseconds. Browser-driven stores (Dons Photo,
# Kerrisdale) load a page per film at ~15-20s each, so covering the catalogue takes
# roughly 20 minutes per store; the rest fetch one catalogue and finish in seconds.
# Raise SCRAPE_BUDGET_BROWSER_MS as the film catalogue grows, or the last films in
# the list stop being scraped.
# SCRAPE_BUDGET_BROWSER_MS=1500000
# SCRAPE_BUDGET_STORE_MS=90000
# SCRAPE_CATALOG_TIMEOUT_MS=180000
# SCRAPE_BUDGET_PINNED_MS=120000
